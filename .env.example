# Variables para docker-compose. Copiá este archivo a `.env` y ajustá los valores.
# NUNCA commitees el .env real con secretos.

# Base de datos
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=cambiar-este-password
POSTGRES_DB=biblioteca

# Backend
JWT_SECRET=poné-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h

# Bibliotecario inicial (seed)
ADMIN_EMAIL=admin@biblioteca.test
ADMIN_PASSWORD=admin12345
