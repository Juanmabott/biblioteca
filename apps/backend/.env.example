# Puerto del servidor HTTP
PORT=3000

# Secreto para firmar los JWT (en producción: usar un secreto fuerte e inyectado)
JWT_SECRET=dev-secret-cambiar-en-produccion
JWT_EXPIRES_IN=1h

# Costo de hashing de bcrypt
BCRYPT_ROUNDS=10

# Reglas de préstamo
DIAS_PRESTAMO=14
MAX_PRESTAMOS_ACTIVOS=3
MIN_PASSWORD_LENGTH=8

# Bibliotecario inicial (seed)
ADMIN_EMAIL=admin@biblioteca.test
ADMIN_PASSWORD=admin12345
